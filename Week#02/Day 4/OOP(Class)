class zaigham:
    def __init__(self,Name,age,cell_no):
        self.name=Name
        self._age=age #protected
        self.__cell=cell_no #private
    def getcell(self):
        return self.__cell
    def setcell(self):
        return self.__cell
    
    def _info(self):
        return f"{self.name} is {self._age} year and his cell no is {self.__cell}"

class ess(zaigham):
    def __init__(self,age,name,cell_no,id):
        super().__init__(name,age,cell_no)
        self.age = age
        self.id =id
    def get_data(self):
        super()._info()
    
e = ess(21,"dawood","03030303",1)

print(e.get_data())